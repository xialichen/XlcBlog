---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { projects } from '../../data/site';
import { websiteId } from '../../lib/seo';
const description = '查看 Qt Widgets 样式、桌面应用脚手架、加载动画组件和 Astro 博客的项目介绍与源码入口。';
const structuredData = Astro.site ? {
  '@type': 'CollectionPage',
  name: '项目列表',
  isPartOf: { '@id': websiteId(Astro.site) },
} : undefined;
---
<BaseLayout title="项目" description={description} structuredData={structuredData}>
  <header class="page-heading"><p class="eyebrow">THE WORKSHOP</p><h1>从想法，到作品<span>.</span></h1><p>一些小小的构建，一些认真的尝试。持续更新，也持续打磨。</p></header>
  <div class="project-grid projects-page">{projects.map(project => <ProjectCard project={project} />)}</div>
  <p class="archive-end">小步构建，慢慢生长。</p>
</BaseLayout>
