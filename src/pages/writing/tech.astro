---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostRow from '../../components/PostRow.astro';
import { getPosts, isTechnicalPost } from '../../lib/posts';
import { websiteId } from '../../lib/seo';

const posts = (await getPosts()).filter(isTechnicalPost);
const title = '技术笔记';
const description = '记录 Qt Widgets 开发、Windows 工具排障与项目实践。';
const structuredData = Astro.site ? {
  '@type': 'CollectionPage',
  name: title,
  isPartOf: { '@id': websiteId(Astro.site) },
} : undefined;
---

<BaseLayout title={title} description={description} structuredData={structuredData}>
  <header class="page-heading">
    <a class="text-link" href="/writing/">← 全部文章</a>
    <h1>{title}<span>.</span></h1>
    <p>{description}</p>
  </header>
  {posts.length > 0 ? (
    <>
      <ul class="post-list archive-list" role="list">{posts.map(post => <PostRow post={post} heading="h2" />)}</ul>
      <p class="archive-end">{posts.length} 篇技术笔记</p>
    </>
  ) : <p class="archive-end">暂无技术笔记。</p>}
</BaseLayout>
