---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { getPosts, formatDate, readingMinutes } from '../../lib/posts';
import '../../styles/briefing.css';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, next: posts[(index + 1) % posts.length], hasNext: posts.length > 1 } }));
}
const { post, next, hasNext } = Astro.props;
const { Content, headings } = await render(post);
const isBriefing = post.data.format === 'briefing';
---
<BaseLayout title={post.data.title} description={post.data.description} article>
  <article class:list={['article-page', { 'briefing-page': isBriefing }]}>
    <header class="article-header"><a class="back-link" href="/writing/">← 全部文章</a><div class="post-meta"><span>{post.data.category}</span><span>·</span><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>·</span><span>{readingMinutes(post.body)} 分钟阅读</span></div><h1>{post.data.title}</h1><p class="article-description">{post.data.description}</p>{post.data.sample && <p class="sample-notice">示例文章 · 用于展示排版和阅读体验</p>}</header>
    <div class="article-body-grid"><div class="prose" data-article-content><Content /></div><TableOfContents headings={headings} /></div>
    <footer class="article-footer"><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div><p>谢谢你读到这里。</p>{hasNext && <a class="next-article" href={`/writing/${next.id}/`}><span>接着读一篇 →</span><strong>{next.data.title}</strong></a>}</footer>
  </article>
</BaseLayout>

<style is:global>
  [data-article-content] .code-copy-block {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    margin: 28px 0;
  }

  [data-article-content] .code-copy-block > pre {
    grid-area: 1 / 1;
    margin: 0;
  }

  .code-copy-tools {
    grid-area: 1 / 1;
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    justify-content: flex-end;
    padding: 6px 8px;
    z-index: 1;
    pointer-events: none;
  }

  .code-copy-button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 32px;
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 5px;
    background: var(--astro-code-background);
    color: var(--astro-code-foreground);
    font: 500 13px/1.25 var(--sans);
    cursor: pointer;
    pointer-events: auto;
  }

  .code-copy-button:hover {
    border-color: var(--accent);
  }

  .code-copy-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: hover) and (pointer: fine) {
    .code-copy-block:not(:hover):not(:focus-within) .code-copy-button {
      opacity: 0;
      pointer-events: none;
    }
  }

  @media (hover: none), (pointer: coarse) {
    .code-copy-button { min-height: 44px; }
  }

  .code-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const copyIcon = '<svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/></svg>';

  for (const pre of document.querySelectorAll<HTMLPreElement>('[data-article-content] pre')) {
    const code = pre.querySelector('code');
    if (!code || pre.parentElement?.classList.contains('code-copy-block')) continue;

    const block = document.createElement('div');
    block.className = 'code-copy-block';
    pre.before(block);
    block.append(pre);

    const tools = document.createElement('div');
    tools.className = 'code-copy-tools';
    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.setAttribute('aria-label', '复制代码');
    button.innerHTML = copyIcon;
    const label = document.createElement('span');
    label.textContent = '复制';
    button.append(label);
    const status = document.createElement('span');
    status.className = 'code-copy-status';
    status.setAttribute('role', 'status');
    tools.append(button, status);
    block.append(tools);

    let reset: number | undefined;
    let copying = false;
    button.addEventListener('click', async () => {
      if (copying) return;
      copying = true;
      window.clearTimeout(reset);
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        label.textContent = '已复制';
        status.textContent = '代码已复制';
      } catch {
        label.textContent = '复制失败';
        status.textContent = '复制失败，请选中代码后手动复制';
      } finally {
        reset = window.setTimeout(() => {
          label.textContent = '复制';
          status.textContent = '';
        }, 2000);
        copying = false;
      }
    });
  }
</script>
