---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleComments from '../../components/ArticleComments.astro';
import TableOfContents from '../../components/TableOfContents.astro';
import { profile } from '../../data/site';
import { getPosts, formatDate, readingMinutes } from '../../lib/posts';
import { authorSchema, websiteId } from '../../lib/seo';
import '../../styles/briefing.css';
export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post, index) => ({ params: { slug: post.id }, props: { post, next: posts[(index + 1) % posts.length], hasNext: posts.length > 1 } }));
}
const { post, next, hasNext } = Astro.props;
const { Content, headings } = await render(post);
const isBriefing = post.data.format === 'briefing';
const datePublished = post.data.date.toISOString().slice(0, 10);
const site = Astro.site;
const image = site && post.data.image ? new URL(post.data.image, site).href : undefined;
const structuredData = site && !post.data.sample ? {
  '@type': 'BlogPosting',
  headline: post.data.title,
  author: authorSchema(site),
  datePublished,
  articleSection: post.data.category,
  keywords: post.data.tags,
  image,
  mainEntityOfPage: new URL(Astro.url.pathname, site).href,
  isPartOf: { '@id': websiteId(site) },
} : undefined;
---
<BaseLayout title={post.data.title} description={post.data.description} article image={image} structuredData={structuredData}>
  <article class:list={['article-page', { 'briefing-page': isBriefing }]}>
    <header class="article-header">
      <a class="back-link" href="/writing/">← 全部文章</a>
      <div class="post-meta">
        <span>{post.data.category}</span><span aria-hidden="true">·</span>
        <time datetime={datePublished}>{formatDate(post.data.date)}</time>
        {!post.data.sample && <>
          <span aria-hidden="true">·</span>
          <a href="/about/" rel="author">{profile.name}{isBriefing ? ' 整理' : ''}</a>
        </>}
        <span aria-hidden="true">·</span><span>{readingMinutes(post.body)} 分钟阅读</span>
      </div>
      <h1>{post.data.title}</h1>
      <p class="article-description">{post.data.description}</p>
      {post.data.sample && <p class="sample-notice">示例文章 · 用于展示排版和阅读体验</p>}
    </header>
    <div class="article-body-grid"><div class="prose" data-article-content><Content /></div><TableOfContents headings={headings} /></div>
    <footer class="article-footer"><div class="tags">{post.data.tags.map(tag => <span>{tag}</span>)}</div><p>谢谢你读到这里。</p>{hasNext && <a class="next-article" href={`/writing/${next.id}/`}><span>接着读一篇 →</span><strong>{next.data.title}</strong></a>}</footer>
    {!post.data.sample && <ArticleComments article={post.id} />}
  </article>
</BaseLayout>

<style is:global>
  [data-article-content] .code-copy-block {
    margin: 28px 0;
    border: 1px solid var(--line);
    border-radius: 8px;
    background: var(--astro-code-background);
  }

  .code-copy-header {
    position: sticky;
    top: 0;
    z-index: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    box-sizing: border-box;
    min-height: 46px;
    padding: 6px 8px 6px 14px;
    border-radius: 7px 7px 0 0;
    background: color-mix(in srgb, var(--astro-code-background) 94%, var(--astro-code-foreground));
    color: var(--muted);
    font: 500 13px/1.25 var(--mono);
  }

  [data-article-content] .code-copy-block > pre {
    margin: 0;
    border: 0;
    border-radius: 0 0 7px 7px;
  }

  .code-copy-button {
    display: inline-grid;
    place-items: center;
    flex: none;
    width: 34px;
    height: 34px;
    margin-inline-start: auto;
    padding: 0;
    border: 0;
    border-radius: 5px;
    background: transparent;
    color: var(--astro-code-foreground);
    cursor: pointer;
  }

  @media (hover: hover) {
    .code-copy-button:hover {
      background: color-mix(in srgb, var(--astro-code-foreground) 13%, transparent);
    }
  }

  .code-copy-button:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  @media (hover: none), (pointer: coarse) {
    .code-copy-header { min-height: 56px; }
    .code-copy-button { width: 44px; height: 44px; }
  }

  .code-copy-status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const svg = (drawing: string) =>
    '<svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">' +
    drawing + '</svg>';
  const copyIcon = svg('<rect x="8" y="8" width="12" height="12" rx="2"/><path d="M16 8V6a2 2 0 0 0-2-2H6a2 2 0 0 0-2 2v8a2 2 0 0 0 2 2h2"/>');
  const checkIcon = svg('<path d="m5 12 4 4L19 6"/>');
  const errorIcon = svg('<circle cx="12" cy="12" r="9"/><path d="M12 8v5m0 3h.01"/>');

  const languageNames = new Map(Object.entries({
    cpp: 'C++', c: 'C', csharp: 'C#', cs: 'C#', javascript: 'JavaScript',
    js: 'JavaScript', typescript: 'TypeScript', ts: 'TypeScript', tsx: 'TSX',
    jsx: 'JSX', html: 'HTML', css: 'CSS', json: 'JSON', yaml: 'YAML',
    yml: 'YAML', xml: 'XML', bash: 'Bash', sh: 'Shell', shell: 'Shell',
    powershell: 'PowerShell', python: 'Python', py: 'Python', rust: 'Rust',
    go: 'Go', java: 'Java', sql: 'SQL', cmake: 'CMake', qmake: 'qmake',
    markdown: 'Markdown', md: 'Markdown', text: '纯文本', txt: '纯文本',
    plaintext: '纯文本', plain: '纯文本',
  }));

  for (const pre of document.querySelectorAll<HTMLPreElement>('[data-article-content] pre')) {
    const code = pre.querySelector('code');
    if (!code || pre.parentElement?.classList.contains('code-copy-block')) continue;

    const block = document.createElement('div');
    block.className = 'code-copy-block';
    pre.before(block);
    const header = document.createElement('div');
    header.className = 'code-copy-header';
    const language = pre.dataset.language ||
      [...code.classList].find(value => value.startsWith('language-'))?.slice(9);
    const codeIcon = document.createElement('span');
    codeIcon.setAttribute('aria-hidden', 'true');
    codeIcon.textContent = '</>';
    const languageLabel = document.createElement('span');
    languageLabel.textContent = language ? languageNames.get(language.toLowerCase()) ?? language : '纯文本';
    header.append(codeIcon, languageLabel);
    block.append(header, pre);

    const button = document.createElement('button');
    button.type = 'button';
    button.className = 'code-copy-button';
    button.setAttribute('aria-label', '复制代码');
    button.innerHTML = copyIcon;
    const status = document.createElement('span');
    status.className = 'code-copy-status';
    status.setAttribute('role', 'status');
    header.append(button, status);

    let reset: number | undefined;
    let copying = false;
    button.addEventListener('click', async () => {
      if (copying) return;
      copying = true;
      window.clearTimeout(reset);
      status.textContent = '';
      try {
        await navigator.clipboard.writeText(code.textContent ?? '');
        button.innerHTML = checkIcon;
        status.textContent = '代码已复制';
      } catch {
        button.innerHTML = errorIcon;
        status.textContent = '复制失败，请选中代码后手动复制';
      } finally {
        reset = window.setTimeout(() => {
          button.innerHTML = copyIcon;
          status.textContent = '';
        }, 3000);
        copying = false;
      }
    });
  }
</script>
